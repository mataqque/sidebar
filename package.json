{
	"name": "@mataqque/sidebar",
	"version": "0.4.0",
	"description": "Sidebar de dashboard para React/Next: menú por contribuciones (core + plugins), colapsable con flyout y theming por tokens CSS.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mataqque/sidebar.git"
	},
	"keywords": [
		"react",
		"nextjs",
		"sidebar",
		"dashboard",
		"tailwind"
	],
	"sideEffects": [
		"*.css"
	],
	"files": [
		"dist",
		"README.md"
	],
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./next": {
			"types": "./dist/adapters/next.d.ts",
			"import": "./dist/adapters/next.mjs",
			"require": "./dist/adapters/next.js"
		},
		"./styles.css": "./dist/styles/tokens.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"type-check": "tsc --noEmit",
		"build": "tsup && tsc -p tsconfig.build.json && node scripts/copyStyles.mjs",
		"prepare": "yarn build",
		"dev": "tsup --watch"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"lucide-react": "^1.42.0",
		"tailwind-merge": "^2.5.4"
	},
	"peerDependencies": {
		"next": ">=14",
		"react": "^18.2.0 || ^19.0.0",
		"react-dom": "^18.2.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"next": "^16.0.10",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tsup": "^8.5.1",
		"typescript": "^5"
	},
	"module": "./dist/index.mjs"
}
