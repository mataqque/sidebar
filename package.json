{
	"name": "@mataqque/sidebar",
	"version": "0.3.0",
	"description": "Sidebar de dashboard para React/Next: menú por contribuciones (core + plugins), colapsable con flyout y theming por tokens CSS.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mataqque/sidebar.git"
	},
	"keywords": ["react", "nextjs", "sidebar", "dashboard", "tailwind"],
	"sideEffects": ["*.css"],
	"files": ["src", "README.md"],
	"types": "./src/index.ts",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./next": "./src/adapters/next.tsx",
		"./styles.css": "./src/styles/tokens.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"tailwind-merge": "^2.5.4"
	},
	"peerDependencies": {
		"next": ">=14",
		"react": "^18.2.0 || ^19.0.0",
		"react-dom": "^18.2.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"next": "^16.0.10",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"typescript": "^5"
	}
}
